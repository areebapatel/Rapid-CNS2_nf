/*
 * DKFZ ODCF cluster settings.
 *
 * Only site-specific paths live here; everything else comes from
 * nextflow.config. Select with the `dkfz` profile:
 *
 *   nextflow run main.nf ... -profile lsf,singularity,dkfz
 */

params {
    ref          = '/b06x-isilon/b06x-m/mnp_nanopore/software/hg38/hg38.fa'
    annovarPath  = '/b06x-isilon/b06x-m/mnp_nanopore/software/annovar/annovar'
    annovarDB    = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/annovar_humandb'

    // directory CONTAINING Annotations_Human, i.e. AnnotSV's -annotationsDir
    annotsvAnnot = '/b06x-isilon/b06x-m/mnp_nanopore/software/AnnotSV/share/AnnotSV'

    // needed only while the published image predates the bundled CNVpytor
    // gc_*/mask_*.pytor resources
    cnvpytorData = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/cnvpytor_data'

    // shared filesystems that must be visible inside containers
    containerBindPaths = '/b06x-isilon,/omics'
}

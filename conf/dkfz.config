/*
 * DKFZ ODCF cluster settings.
 *
 * Only site-specific paths live here; everything else comes from
 * nextflow.config. Select with the `dkfz` profile:
 *
 *   nextflow run main.nf ... -profile lsf,singularity,dkfz
 */

params {
    ref          = '/b06x-isilon/b06x-m/mnp_nanopore/software/hg38/hg38.fa'
    annovarPath  = '/b06x-isilon/b06x-m/mnp_nanopore/software/annovar/annovar'
    annovarDB    = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/annovar_humandb'

    // Severus somatic filtering: VNTR regions and the 1000G panel of normals
    severusVntr = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/severus/human_GRCh38_no_alt_analysis_set.trf.bed'
    severusPON  = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/severus/PoN_1000G_hg38.tsv.gz'

    // directory CONTAINING Annotations_Human, i.e. AnnotSV's -annotationsDir
    annotsvAnnot = '/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/annotsv_3.5'

    // shared filesystems that must be visible inside containers
    containerBindPaths = '/b06x-isilon,/omics'
}

// Set literally as well: nextflow.config derives runOptions from
// params.containerBindPaths before profile params are merged, so the profile
// value alone would be ignored.
singularity.runOptions = '-B /b06x-isilon,/omics'
docker.runOptions      = '-u $(id -u):$(id -g) -v /b06x-isilon:/b06x-isilon -v /omics:/omics'

// Nextflow's default sendmail transport fails here ("Stream closed"); the local
// postfix on port 25 works.
mail {
    smtp.host = 'localhost'
    smtp.port = 25
    from      = 'a390l@dkfz-heidelberg.de'
}

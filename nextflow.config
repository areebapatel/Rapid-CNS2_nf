import java.time.*
Date now = new Date()

manifest {
    name            = 'Rapid-CNS2_nf'
    author          = 'Areeba Patel'
    homePage        = 'https://github.com/areebapatel/Rapid-CNS2_nf'
    description     = 'Comprehensive molecular profiling of CNS tumours from ONT adaptive sampling data'
    mainScript      = 'main.nf'
    version         = '3.0.0'
    nextflowVersion = '>=23.10.0'
}

params {
    outDir = "output"
    traceDir = "${params.outDir}/pipeline_info"
    tmpDir = "${params.outDir}/tmp/"
    timestamp = now.format("yyyyMMdd-HH-mm-ss")
    seq = "P2S" // sequencer id, or 'false' to auto-detect from the BAM header
    maxThreads = 64
    minimumMgmtCov = 5
    ref = "/b06x-isilon/b06x-m/mnp_nanopore/software/hg38/hg38.fa" // Set this to the path to the reference genome
    annovarPath = "/b06x-isilon/b06x-m/mnp_nanopore/software/annovar/annovar/" // Set this to the path to the ANNOVAR installation
    annovarDB = "/omics/odcf/analysis/OE0497_projects/methylation_platforms/code/data/annovar_humandb" // Set this to the path to the ANNOVAR annotations
    // AnnotSV annotations live on the host, NOT in the container: they are
    // ~6.6 GB and are released independently of the AnnotSV code.
    // Point this at the directory CONTAINING Annotations_Human (AnnotSV's
    // -annotationsDir), i.e. <install>/share/AnnotSV - not at Annotations_Human.
    annotsvAnnot = "/b06x-isilon/b06x-m/mnp_nanopore/software/AnnotSV/share/AnnotSV"
    bamMinCoverage = 10
    annotations = "${projectDir}/data/refGene.txt.gz"

    // Clair3 model - MUST match the dorado model the BAM was basecalled with.
    // Available in the container: r1041_e82_400bps_{hac,sup}_v{410,500,520,600}
    clair3Model = null // auto-detected from the BAM @RG basecall_model; set to override

    // Severus somatic filtering resources (optional but recommended).
    // VNTR bed: https://github.com/KolmogorovLab/Severus  vntrs/human_GRCh38_no_alt_analysis_set.trf.bed
    // PON:      https://github.com/KolmogorovLab/Severus  pon/PoN_1000G_hg38.tsv.gz
    severusVntr = null
    severusPON  = null

    // SAVANA het-SNP set for B-allele frequency / purity estimation
    savanaG1000 = "1000g_hg38"

    // ANNOVAR databases. These five download freely with
    //   annotate_variation.pl -buildver hg38 -downdb -webfrom annovar <db> humandb/
    // Add cosmic70 (needs a COSMIC licence), dbnsfp47a and allofus to both lists
    // if you have them installed - the two lists must stay the same length.
    annovarProtocol  = "refGene,cytoBand,clinvar_20240917,avsnp151,1000g2015aug_eur"
    annovarOperation = "gx,r,f,f,f"

    modkitThreads = 32
    cnvThreads  = 32
    snifflesThreads = 32
    snpThreads = 64
    svThreads = 64
    covThreads = 8
    methThreads = 64
    mgmtThreads = 8
    runHumanVariation = false
    snifflesNonGermline = true // tumour-only input, so call somatic SVs
    mnpFlex = true
    containerEngine = 'docker' // Set to 'docker' or 'singularity' (default: docker)
    // Host paths to bind into containers. Singularity only auto-mounts the work
    // directory, so reference/ANNOVAR/AnnotSV paths outside it must be listed.
    containerBindPaths = '/b06x-isilon,/omics' 
    patient = null // Will be set to id if not specified
}

process {
  withLabel:rapid_cns {
    container = 'areebapatel/rapid_cns:3.0.0'
  }

  withLabel:mods {
    // ontresearch/modkit publishes no version tags; biocontainers is pinnable.
    container = 'quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0'
  }

  withLabel:clair3 {
    // official image - bundles the ONT models under /opt/models
    container = 'hkubal/clair3:v2.0.2'
  }

  withLabel:severus {
    container = 'quay.io/biocontainers/severus:1.7--pyhdfd78af_0'
  }

  withLabel:savana {
    container = 'quay.io/biocontainers/savana:1.3.8--pyhdfd78af_0'
  }
}

// Container engine selection
singularity {
    enabled = params.containerEngine == 'singularity'
    autoMounts = true
    runOptions = params.containerBindPaths ? "-B ${params.containerBindPaths}" : ''
}
docker {
    enabled = params.containerEngine == 'docker'
    runOptions = params.containerBindPaths
        ? '-u $(id -u):$(id -g) ' + params.containerBindPaths.split(',').collect { "-v ${it}:${it}" }.join(' ')
        : '-u $(id -u):$(id -g)'
}

profiles {
  lsf {
    process.executor = 'lsf'
    process.queue = 'verylong'
    process.memory = '8 GB'
    process.cpus = 2

    // Use native cpus/memory/queue directives rather than clusterOptions
    // strings. Nextflow already renders those into -n / -R rusage[mem] / -q,
    // so hand-writing them in clusterOptions produced duplicate -n and -q
    // flags on every bsub.
    process {
      withLabel:rapid_cns { cpus = 8;  memory = '32 GB' }
      withLabel:mods      { cpus = 32; memory = '32 GB' }
      withLabel:clair3    { cpus = 32; memory = '64 GB' }
      withLabel:severus   { cpus = 16; memory = '64 GB' }
      withLabel:savana    { cpus = 16; memory = '64 GB' }
    }

    // LSF here applies the memory request per job, not per core
    executor.perJobMemLimit = true
  }

  slurm {
    process.executor = 'slurm'
    process.queue = 'batch'
    process.memory = '8 GB'
    process.cpus = 2

    process {
      withLabel:rapid_cns { cpus = 8;  memory = '32 GB' }
      withLabel:mods      { cpus = 32; memory = '32 GB' }
      withLabel:clair3    { cpus = 32; memory = '64 GB' }
      withLabel:severus   { cpus = 16; memory = '64 GB' }
      withLabel:savana    { cpus = 16; memory = '64 GB' }
    }
  }

  local {
    process.executor = 'local'
    process.memory = '4 GB'
    process.cpus = 1
  }
}

timeline {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_timeline.html"
}

report {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_report.html"
}

trace {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_trace.txt"
}

import java.time.*
Date now = new Date()

manifest {
    name            = 'Rapid-CNS2_nf'
    author          = 'Areeba Patel'
    homePage        = 'https://github.com/areebapatel/Rapid-CNS2_nf'
    description     = 'Comprehensive molecular profiling of CNS tumours from ONT adaptive sampling data'
    mainScript      = 'main.nf'
    // pipeline version; the container image is tagged separately
    version         = '3.0.0'
    nextflowVersion = '>=23.10.0'
}

params {
    outDir = "output"
    timestamp = now.format("yyyyMMdd-HH-mm-ss")
    minimumMgmtCov = 5
    // Site paths - set these for your system, or keep them in your own config
    // and pass it with -c site.config
    ref          = null
    annovarPath  = null
    annovarDB    = null
    // directory CONTAINING Annotations_Human, i.e. AnnotSV's -annotationsDir
    annotsvAnnot = null
    bamMinCoverage = 10
    annotations = "${projectDir}/data/refGene.txt.gz"

    // Clair3 model - MUST match the dorado model the BAM was basecalled with.
    // Available in the container: r1041_e82_400bps_{hac,sup}_v{410,500,520,600}
    clair3Model = null // auto-detected from the BAM @RG basecall_model; set to override

    // Severus somatic filtering resources (optional but recommended).
    // VNTR bed: https://github.com/KolmogorovLab/Severus  vntrs/human_GRCh38_no_alt_analysis_set.trf.bed
    // PON:      https://github.com/KolmogorovLab/Severus  pon/PoN_1000G_hg38.tsv.gz
    severusVntr = null
    severusPON  = null

    // SAVANA het-SNP set for B-allele frequency / purity estimation
    savanaG1000 = "1000g_hg38"
    // Extra flags for `savana cna`, e.g. to relax the purity/ploidy viability
    // filters when no fit is found (see No_fit_found_PARAMS.tsv in its output).
    savanaCnaArgs = ''

    // ANNOVAR databases. These five download freely with
    //   annotate_variation.pl -buildver hg38 -downdb -webfrom annovar <db> humandb/
    // Add cosmic70 (needs a COSMIC licence), dbnsfp47a and allofus to both lists
    // if you have them installed - the two lists must stay the same length.
    annovarProtocol  = "refGene,cytoBand,clinvar_20240917,avsnp151,1000g2015aug_eur"
    annovarOperation = "gx,r,f,f,f"
    // only used by the optional wf-human-variation subworkflow; every other
    // process takes its thread count from task.cpus
    snpThreads = 64
    svThreads  = 64
    runHumanVariation = false
    snifflesMosaic = true // tumour-only input: Sniffles --mosaic (was --non-germline)
    mnpFlex = true
    // Optional upload of the MNP-Flex bed to app.epignostix.com, off by default.
    // Credentials come from EPIGNOSTIX_USER / EPIGNOSTIX_PASSWORD in the
    // environment - never put them in a config file.
    mnpFlexUpload       = false
    mnpFlexApi          = 'https://app.epignostix.com/api'
    // 18 = "MNP-Flex Analysis"; list ids with GET /v1/workflows?entity_type=mnpflex_sample
    mnpFlexWorkflowId   = 18
    // these must match the strings the platform expects
    mnpFlexTechnology   = 'Nanopore sequencing- PromethION'
    mnpFlexCoverage     = '>10X'
    mnpFlexExtraction   = 'Frozen'
    mnpFlexSex          = 'ND'
    mnpFlexWait         = 600   // seconds to wait for the MNP-Flex analysis
    mnpFlexLocalisation = null
    mnpFlexDiagnosis    = null
    // The prepared full-flow-cell BAM is >150 GB and reproducible from the
    // input, so it is not published by default. Set true to keep a copy.
    publishBam = false

    // Ceilings on what any single process may request. Lower these to run on a
    // workstation or a small cluster, e.g. --maxCpus 8 --maxMemory 32
    maxCpus   = 64
    maxMemory = 96   // GB
    // Host paths to bind into containers. Singularity only auto-mounts the work
    // directory, so reference/ANNOVAR/AnnotSV paths outside it must be listed.
    containerBindPaths = ''
    // Fusion screen thresholds
    minFusionLen   = 10000  // smallest DEL/DUP/INV that can rearrange two genes
    minFusionReads = 10
    minFusionMapq  = 50
    // EGFR transcript whose exon 2-7 bounds define EGFRvIII. Shorter transcripts
    // lack exon 4 and would shift the numbering.
    egfrTranscript = "NM_005228"
    knownFusions   = "${projectDir}/data/cns_fusions.tsv"

    // Recurrent CNS variants always kept by the SNV filter (the TERT promoter
    // variants are "upstream", not exonic)
    cnsHotspots    = "${projectDir}/data/cns_hotspots.tsv"

    patient = null // Will be set to id if not specified
    email   = null // --email <addr> to be notified on success or failure
}

// Container and resources per label. Do not repeat a withLabel selector inside
// a profile: the profile's block replaces this one and drops the container.
process {
  // Clamped by maxCpus/maxMemory. Closures, so --maxCpus on the command line is
  // seen: a plain expression is evaluated before --params are merged.
  cpus   = { Math.min(  2, params.maxCpus   as int) }
  memory = { "${Math.min(  8, params.maxMemory as int)} GB" }
  errorStrategy = 'finish'   // let running tasks finish before shutting down

  withLabel:rapid_cns {
    container = 'areebapatel/rapid_cns:3.0.2'
    cpus   = { Math.min(  8, params.maxCpus   as int) }
    memory = { "${Math.min( 32, params.maxMemory as int)} GB" }
  }

  // sorting/indexing a full flow-cell BAM (>150 GB)
  withLabel:bamprep {
    container = 'areebapatel/rapid_cns:3.0.2'
    cpus   = { Math.min( 32, params.maxCpus   as int) }
    memory = { "${Math.min( 96, params.maxMemory as int)} GB" }
  }

  // compute-bound: Sniffles2, CNVpytor and the ranger classifier
  withLabel:heavy {
    container = 'areebapatel/rapid_cns:3.0.2'
    cpus   = { Math.min( 32, params.maxCpus   as int) }
    memory = { "${Math.min( 64, params.maxMemory as int)} GB" }
  }

  withLabel:mods {
    // ontresearch/modkit publishes no version tags; biocontainers is pinnable.
    container = 'quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0'
    cpus   = { Math.min( 32, params.maxCpus   as int) }
    memory = { "${Math.min( 64, params.maxMemory as int)} GB" }
  }

  withLabel:clair3 {
    // official image - bundles the ONT models under /opt/models
    container = 'hkubal/clair3:v2.0.2'
    cpus   = { Math.min( 64, params.maxCpus   as int) }
    memory = { "${Math.min( 96, params.maxMemory as int)} GB" }
  }

  withLabel:severus {
    container = 'quay.io/biocontainers/severus:1.7--pyhdfd78af_0'
    cpus   = { Math.min( 32, params.maxCpus   as int) }
    memory = { "${Math.min( 64, params.maxMemory as int)} GB" }
  }

  // savana's calling stage peaks with the number of parallel workers
  withLabel:savana {
    container = 'quay.io/biocontainers/savana:1.3.8--pyhdfd78af_0'
    cpus   = { Math.min( 16, params.maxCpus   as int) }
    memory = { "${Math.min( 96, params.maxMemory as int)} GB" }
  }
}

// Container engine defaults, selected by the singularity / docker profiles.
singularity {
    autoMounts = true
    // Nextflow does not forward the host environment into containers; whitelist
    // the MNP-Flex credentials, which also keeps them out of .command.run.
    envWhitelist = 'EPIGNOSTIX_USER,EPIGNOSTIX_PASSWORD'
    runOptions = params.containerBindPaths ? "-B ${params.containerBindPaths}" : ''
}
docker {
    envWhitelist = 'EPIGNOSTIX_USER,EPIGNOSTIX_PASSWORD'
    runOptions = params.containerBindPaths
        ? '-u $(id -u):$(id -g) ' + params.containerBindPaths.split(',').collect { "-v ${it}:${it}" }.join(' ')
        : '-u $(id -u):$(id -g)'
}

profiles {
  singularity {
    singularity.enabled = true
    docker.enabled      = false
  }

  docker {
    docker.enabled      = true
    singularity.enabled = false
  }

  dkfz {
    includeConfig 'conf/dkfz.config'
  }

  lsf {
    process.executor = 'lsf'
    process.queue    = 'verylong'
    // LSF here applies the memory request per job, not per core
    executor.perJobMemLimit = true
  }

  slurm {
    process.executor = 'slurm'
    process.queue    = 'batch'
  }

  local {
    process.executor = 'local'
  }

  // Delete the work directory on success. Results are unaffected, but -resume
  // is no longer possible.
  cleanup {
    cleanup = true
  }
}

timeline {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_timeline.html"
}

report {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_report.html"
}

trace {
  enabled = true
  file = "${params.outDir}/pipeline_info/${params.timestamp}_trace.txt"
}
